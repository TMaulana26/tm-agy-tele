# ==============================================================================
# KONFIGURASI TELEGRAM BOT & KEAMANAN
# ==============================================================================
# Token API dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# ID Telegram Akang (HANYA ID ini yang diizinkan berinteraksi dengan bot)
# Dapatkan ID via bot @userinfobot di Telegram. Bisa satu ID atau koma jika multiple (contoh: "7163641352,12345678")
ALLOWED_USER_ID="7163641352"

# ==============================================================================
# ENGINE & BINARY PATH ANTIGRAVITY CLI (agy)
# ==============================================================================
# Path ke binary agy di VPS atau Laptop
# Linux VPS default : /home/ubuntu/.local/bin/agy
# Windows default   : C:\Users\<Username>\AppData\Local\agy\bin\agy.exe
AGY_BIN_PATH="/home/ubuntu/.local/bin/agy"

# Direktori workspace tempat agen membaca & memodifikasi kode
# Linux VPS default : /home/ubuntu
# Docker default    : /workspace
WORKSPACE_DIR="/home/ubuntu"

# ==============================================================================
# APPROVAL & SANDBOX SETTINGS (ALA HERMES)
# ==============================================================================
# Mode Persetujuan Perintah:
# - "ask_destructive" : Minta persetujuan hanya untuk instruksi mutasi/hapus/terminal berisiko (Recommended)
# - "auto_approve"    : Eksekusi otomatis tanpa konfirmasi (kecuali Hardline Blocklist yang selalu diblokir total)
APPROVAL_MODE="ask_destructive"

# Batas waktu tunggu tombol Approve/Deny (dalam detik). Default: 120 detik (Fail-closed).
APPROVAL_TIMEOUT_SECONDS=120
