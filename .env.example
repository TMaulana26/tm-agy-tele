# ==============================================================================
# KONFIGURASI TELEGRAM BOT & KEAMANAN
# ==============================================================================
# Token API dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# ID Telegram Akang (HANYA ID ini yang diizinkan berinteraksi dengan bot)
# Dapatkan ID via bot @userinfobot di Telegram. Bisa satu ID atau koma jika multiple (contoh: "123456789,987654321")
ALLOWED_USER_ID="123456789"

# ==============================================================================
# ENGINE & BINARY PATH ANTIGRAVITY CLI (agy)
# ==============================================================================
# Path ke binary agy di VPS atau Laptop
# Linux VPS default : /home/ubuntu/.local/bin/agy
# Windows default   : C:\Users\<Username>\AppData\Local\agy\bin\agy.exe
AGY_BIN_PATH="/home/ubuntu/.local/bin/agy"

# Direktori workspace tempat agen membaca & memodifikasi kode.
# Gunakan subfolder proyek, BUKAN home directory: seluruh isi workspace dapat
# dikirim balik ke Telegram oleh agent (kecuali file kredensial yang diblokir Media Guard).
# Linux VPS default : /home/ubuntu/projects
# Docker default    : /workspace
WORKSPACE_DIR="/home/ubuntu/projects"

# Akar direktori yang boleh dipakai sebagai workspace topik (/topic Nama --path=...).
# Pisahkan dengan koma. Default: WORKSPACE_DIR dan home directory user bot.
# TOPIC_WORKSPACE_ROOTS="/home/ubuntu/projects,/var/www"

# ==============================================================================
# APPROVAL & SANDBOX SETTINGS (ALA HERMES)
# ==============================================================================
# Mode Persetujuan Perintah:
# - "ask_destructive" : Minta persetujuan hanya untuk instruksi mutasi/hapus/terminal berisiko (Recommended)
# - "auto_approve"    : Eksekusi otomatis tanpa konfirmasi (kecuali Hardline Blocklist yang selalu diblokir total)
APPROVAL_MODE="ask_destructive"

# Batas waktu tunggu tombol Approve/Deny (dalam detik). Default: 120 detik (Fail-closed).
APPROVAL_TIMEOUT_SECONDS=120

# Jalankan agy dengan --dangerously-skip-permissions (default: true).
# PENTING: Approval & Hardline Blocklist hanya memeriksa TEKS instruksi Anda, bukan setiap
# aksi yang dijalankan agent. Selama ini "true", agent bebas menjalankan tool apa pun di VPS.
AGY_SKIP_PERMISSIONS="true"

# ==============================================================================
# SUBPROCESS EXECUTION & RESILIENCE
# ==============================================================================
# Batas waktu eksekusi subprocess agy CLI (dalam detik). Default: 300 detik (5 menit).
# Disarankan 300-600 detik jika sering melakukan tugas berat (analisis kode, audit, testing).
AGY_TIMEOUT_SECONDS=300

# ==============================================================================
# MODEL & TOPICS (HERMES PARITY)
# ==============================================================================
# Default AI model for conversations and new topics
DEFAULT_MODEL="gemini-3.8-flash-high"

# ==============================================================================
# NETWORK & RESILIENCE (DOH & FALLBACK IP TRANSPORT)
# ==============================================================================
# Aktifkan fallback transport (DoH via Cloudflare/Google & IP direct rewrite)
# Sangat berguna jika ISP / firewall memblokir atau membatasi api.telegram.org
TELEGRAM_FALLBACK_TRANSPORT="false"

# Path kustom untuk database state (opsional, default: .telegram_state/state.db)
# STATE_DB_PATH="/home/ubuntu/.telegram_state/state.db"


# ==============================================================================
# DOCKER (hanya untuk ./deploy.sh --docker)
# ==============================================================================
# Folder ~/.gemini host (kredensial & transkrip agy), di-mount read-write ke container
# HOST_GEMINI_DIR="/home/ubuntu/.gemini"
# Folder proyek host yang di-mount sebagai /workspace (jangan arahkan ke repo bot ini)
# HOST_WORKSPACE_DIR="/home/ubuntu/projects"
# Lokasi binary agy di dalam container (default: /root/.gemini/antigravity-cli/bin/agy)
# CONTAINER_AGY_BIN_PATH="/root/.gemini/antigravity-cli/bin/agy"
